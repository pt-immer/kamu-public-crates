# --- The YugabyteDB version pin (P1.1) -----------------------------------------------------------
# The three adaptations are facts about YugabyteDB's HEADERS, so a release that moves a symbol is
# the standing risk -- the pgrx fork relocates the patch, it does not remove that exposure. Three
# things answer three different questions: this recipe asks whether the tag still resolves to the
# validated digest; yb/probe-yb-abi.sh (inside the build) asks whether the headers still have the
# assumed shape; and the COMPILER asks whether the adaptation applied at all -- which is what a
# fork buys over the textual shim it replaced, where a patch matching nothing failed silently.
# YB_PULL=1, and that is the whole point of this recipe. yb-image.sh normally trusts the LOCAL
# image, which is right for the twenty other recipes that just need a stable identity for one run --
# but "has the tag moved?" is a question about the REGISTRY, and answering it from a cache is how
# this recipe came to print "the tag still resolves to the validated digest" over the top of a
# stale local copy. It also used to print that line after yb-image.sh had merely WARNED about an
# unrecorded tag; yb-image.sh now states its own verdict, so this one does not restate it.
[doc("Is the YugabyteDB tag still the digest the pgrx fork was validated against? (hits the registry)")]
yb-pin-check tag="":
    #!/usr/bin/env bash
    set -euo pipefail
    echo "pinned:"
    grep -v '^[[:space:]]*#' kamu-money-pg/yb/YB-PINNED.txt | grep -v '^[[:space:]]*$'
    echo "the registry resolves it to:"
    YB_PULL=1 ./kamu-money-pg/yb/yb-image.sh {{ tag }}

[doc("Negative controls for the image pin gate: every refusal path, and both overrides.")]
yb-image-selftest:
    ./kamu-money-pg/yb/yb-image-selftest.sh

# In `gate-offline`, not `gate-pg`, because it needs neither Docker nor a database: every rule it
# controls is about names, versions and hashes in a directory, so the fixtures are `printf`. The
# resolver decides WHICH BYTES a YB suite installs, which makes it the thing that determines what
# any green run is a statement about -- too load-bearing to leave behind a container gate.
[doc("Negative controls for the artifact resolver: provenance, coherence, and the maxdepth rule.")]
artifact-selftest:
    ./kamu-money-pg/yb/artifact-selftest.sh


# Also `gate-offline`: no Docker, no database, two subshells and a file descriptor. Both properties of
# the lock are easy to break in a way that looks fine -- a lock that never excludes lets two runs
# quietly corrupt one run's output, and a lock that is not re-entrant deadlocks `gate-pg-release`
# against its own suites, which reads as a hung gate rather than as a bug in the lock.
[doc("Negative controls for the single-writer lock: exclusion, re-entrancy, release on kill.")]
workspace-lock-selftest:
    ./kamu-money-pg/yb/workspace-lock-selftest.sh


# Also `gate-offline`: pure string comparison, no /sys, no /proc, no docker, no second socket. A pin
# verifier that blesses a half-applied pin is worse than none, because the number it blesses looks
# controlled -- and it did exactly that until 2026-07-26, comparing only the memory mask.
[doc("Negative controls for the NUMA pin verifier: CPU-only and memory-only mismatch.")]
numa-selftest:
    ./kamu-money-pg/bench/numa-selftest.sh

# --- Measurement (P2) ---------------------------------------------------------------------------
# Never gates. A benchmark has no pass/fail threshold on its first run -- there is nothing to
# regress against -- and a soak's duration is a decision, not a default.
#
# THESE ARE FIXTURES, NOT ONE-OFFS, and that is the point. E20's figures were measured with code
# that was deliberately thrown away, which left kamu-money-core's DESIGN.md §1 saying "reproduce before trusting"
# directly above an entry nobody could reproduce. `bench-rust` and `bench-pg` are what make those
# numbers checkable; they are deliberately OUTSIDE `gate-offline`, `gate-pg` and `gate-pg-release`,
# because a timing that can fail a gate on a loaded machine is a gate that gets disabled.


[doc("SQL cost: kmoney vs numeric(36,18) on stock PostgreSQL, with the floor. Never a gate.")]
bench-pg major="18":
    ./kamu-money-pg/bench/run-bench-pg.sh {{ major }}

# What a pgrx CALL costs, separately from what any function does. Two functions with identical
# signatures -- one five lines of C, one a `#[pg_extern]` -- each returning its argument; the
# difference is the wrapper and nothing else.
#
# SEPARATE FROM `bench-pg` because it needs the extension built with `--features boundary-probe`,
# which `bench-pg` deliberately does not use: the probe functions are not in the shipped SQL
# surface. E20's boundary figures were produced by appending those functions to lib.rs inside a
# container and committing none of it, which is why a 2026-07-26 review could not reproduce them.
[doc("What a pgrx call costs, against a null C function of the same signature. Never a gate.")]
bench-boundary major="18":
    ./kamu-money-pg/bench/run-bench-boundary.sh {{ major }}

# THE SAME QUESTION ON THE DEPLOYMENT TARGET, and the answer that actually decides anything.
# YSQL is multi-threaded, so `CurrentMemoryContext` is the thread-local `YbCurrentMemoryContext`
# that pgrx's wrapper touches on every call -- a TLS access costs more than a process-global
# load, and that is the one named mechanism for the boundary to be dearer here than on stock
# PostgreSQL. "It passes on PostgreSQL" is not evidence about YugabyteDB.
#
# Builds `--target boundary-node`, which is NOT the deployable `node` image: both functions have
# to be compiled against YB's own PG15 headers and glibc for the subtraction to mean anything,
# and a deployable image must never carry a function that exists to be timed. `gate-pg-release`
# greps the shipped artifact for exactly those symbols.
[doc("The pgrx call cost on YugabyteDB, where the multi-threaded memory context lives.")]
bench-boundary-yb tag="":
    ./kamu-money-pg/bench/run-bench-boundary-yb.sh {{ tag }}

# THE SAME kmoney-vs-numeric FIXTURE, on the engine this deploys to.
#
# Not a formality. YugabyteDB scans DocDB over the network where stock PostgreSQL scans a local
# heap -- E20 measured ~378 ms against ~23 ms for the same table -- so a per-row type difference
# of tens of nanoseconds sits on top of a floor sixteen times larger. WHETHER THAT FLOOR SWAMPS
# THE DIFFERENCE IS THE ANSWER a schema designer needs, and it is a measurement rather than a
# deduction: "the direction is obvious" is how a magnitude nobody checked becomes a design input.
#
# Fewer rows than `bench-pg` by default, because DocDB writes cost more; the per-row figures
# normalise and the row count is printed with them. Boots the DEPLOYABLE node image -- a
# benchmark of the shipped extension has to be a benchmark of the shipped extension.
#
# May legitimately REFUSE: the fixture aborts rather than print a summary under a floor spread
# above 1.5, and DocDB variance is exactly what trips it. That refusal is a result.
[doc("kmoney vs numeric on YugabyteDB: arithmetic, render, parse, storage. Never a gate.")]
bench-sql-yb rows="100000" passes="5" tag="":
    ./kamu-money-pg/bench/run-bench-sql-yb.sh {{ rows }} {{ passes }} "{{ tag }}"

# WHY numeric costs what it does on YugabyteDB, rather than assuming.
#
# E20 first attributed it to varlena-versus-fixed-width decoding -- a generic story that should
# hold on stock PostgreSQL too, and one that does not explain the gap WIDENING from ~2.7x on
# PG18 to >=8.8x on YB. The operator proposed the mechanism that does: YugabyteDB separates
# storage from compute, DocDB models decimals natively, so a PG `numeric` is translated at the
# boundary on every read while a type DocDB has never heard of comes back as opaque bytes.
#
# `bytea` decides it -- variable-length like numeric, opaque like kmoney. Measured: it lands
# with kmoney, four times cheaper than numeric. Variable length is not the cost.
[doc("Why numeric is dear on YugabyteDB: bytea discriminates varlena cost from numeric cost.")]
bench-why-yb rows="100000" passes="9" tag="":
    ./kamu-money-pg/bench/run-bench-sql-yb.sh {{ rows }} {{ passes }} "{{ tag }}" kamu-money-pg/bench/why-numeric-costs.sql

[doc("Baseline: kmoney vs text vs numeric(36,18) on a YugabyteDB cluster. No pass/fail threshold.")]
bench-yb rows="20000" tag="":
    #!/usr/bin/env bash
    set -euo pipefail
    ./kamu-money-pg/yb/run-yb-bench.sh "$(./kamu-money-pg/yb/yb-image.sh {{ tag }})" "" {{ rows }}

[doc("Sustained concurrent double-entry traffic, asserting conservation every round.")]
yb-soak minutes="3" tag="":
    #!/usr/bin/env bash
    set -euo pipefail
    ./kamu-money-pg/yb/run-yb-soak.sh {{ minutes }} "$(./kamu-money-pg/yb/yb-image.sh {{ tag }})"

# The A/B, against an identity that has ALREADY been resolved. Split out of `yb-ab` on 2026-07-26
# because `gate-pg-release` used to resolve `$YB_REF` and then call `just yb-ab {{ tag }}`, handing
# the MUTABLE TAG back to a recipe that resolved it a second time. Both resolutions printed, both
# happened to agree, and the comment above them claimed one resolution was what prevented a
# straddle. On a shared daemon -- or with YB_PULL=1 while a tag moves -- the artifact build and A/B
# could have run against a different immutable reference from the four suites after them, which is
# the exact failure the single-resolution rule exists to prevent, reintroduced by the code that
# described it.
#
# The argument is TYPE-CHECKED, not trusted. `yb-image.sh` prints `repo@sha256:...` (or a bare
# image ID for a locally-built one); a mutable tag contains no `sha256:`. So passing a tag in here
# is refused rather than silently resolved, and there is no path by which this recipe can pick an
# identity of its own.
# TWO identities, because they answer different questions. `base` is the stock YugabyteDB image:
# the artifact and the PG15 reference are both COMPILED against it, which is what makes the diff
# attributable to the fork's ABI and nothing else. `runtime` is the image the battery actually
# BOOTS -- normally the same thing, but for a release it is the deployable node image, so that what
# gets certified is the artifact that ships rather than a harness installing loose files onto stock.
[private]
_yb-ab-ref base runtime="":
    #!/usr/bin/env bash
    set -euo pipefail
    # BEFORE the artifact build, the battery run and the PG15 reference extraction -- all three
    # write fixed paths. `gate-pg-release` and `yb-ab` already hold it and are let through by the
    # descriptor check; this covers the case where neither does.
    source ./kamu-money-pg/yb/workspace-lock.sh
    workspace_lock "yb-ab" || exit 1
    BASE="{{ base }}"
    RUNTIME="{{ runtime }}"
    [ -n "$RUNTIME" ] || RUNTIME="$BASE"
    for ref in "$BASE" "$RUNTIME"; do
        case "$ref" in
            *sha256:*) ;;
            *)
                echo "_yb-ab-ref: '$ref' is not an immutable reference." >&2
                echo "_yb-ab-ref: this recipe takes ALREADY-RESOLVED identities so that one run is" >&2
                echo "_yb-ab-ref: a claim about one image. Resolve first, or use 'just yb-ab <tag>'." >&2
                exit 2 ;;
        esac
    done
    echo "yb: base identity    $BASE (artifact build and PG15 reference are compiled against this)"
    echo "yb: battery runtime  $RUNTIME"
    if [ "$RUNTIME" = "$BASE" ]; then
        # Stock base: the battery has to be given the extension, so build the loose triplet.
        docker build -f kamu-money-pg/yb/Dockerfile --target artifact \
            --build-arg YB_IMAGE="$BASE" -o kamu-money-pg/yb/out .
    else
        # The runtime image carries kmoney already. NOTHING is built or copied for the YB side --
        # that is the point: this run exercises the shipped bytes, in the image that ships them.
        echo "yb: runtime differs from base, so it is a node image that already carries kmoney;"
        echo "yb: no artifact build, and run-yb.sh will refuse to install onto it."
        export YB_REQUIRE_BAKED=1
    fi
    ./kamu-money-pg/yb/run-yb.sh "$RUNTIME" "" kamu-money-pg/yb/out/out-yb.txt kamu-money-pg/yb/abi_battery.sql
    # run-yb.sh and the PG15 build each assert their OWN output reached the end with its named
    # markers and refusals. This asserts the ASSERTER: it mutates a real output seven ways and
    # requires each to be rejected for its own reason, so an oracle that has rotted into
    # always-passing cannot quietly certify the diff below. Pure grep, hence every run.
    ./kamu-money-pg/yb/assert-battery-selftest.sh kamu-money-pg/yb/out/out-yb.txt
    docker build -f kamu-money-pg/yb/Dockerfile.pg15 --target ref \
        --build-arg YB_IMAGE="$BASE" -o kamu-money-pg/yb/out/ref .
    # The PG15 side asserted itself during the build; re-assert the EXTRACTED file, because what
    # gets diffed is this copy, not the one the build looked at.
    ./kamu-money-pg/yb/assert-battery.sh kamu-money-pg/yb/out/ref/out-pg15.txt pg15-extracted 0
    # Normalize ONLY the psql/ysqlsh error-location prefix (client binary + input path + line):
    # that is harness metadata, not kmoney's error text, which follows it verbatim and must match.
    norm() { sed -E 's/^(psql|ysqlsh):[^:]*:[0-9]+:/CLIENT:/'; }
    echo "=== A/B diff: YugabyteDB vs stock PG15 -- empty = byte-exact, zero YB edges ==="
    if diff <(norm < kamu-money-pg/yb/out/out-yb.txt) <(norm < kamu-money-pg/yb/out/ref/out-pg15.txt); then
        echo "yb-ab: BYTE-EXACT -- kmoney behaves identically on YugabyteDB and stock PG15"
    else
        echo "yb-ab: DIVERGENCE (investigate above)"; exit 1
    fi

# The hand-invocation entry point: resolve the tag ONCE, here, then hand the immutable reference
# to the recipe that does the work. Every other caller that already holds a resolved identity
# calls `_yb-ab-ref` directly, so no path resolves twice.
[doc("Byte-exact A/B: the SAME battery on YB and stock PG15 -- an empty diff is the gate.")]
yb-ab tag="":
    #!/usr/bin/env bash
    set -euo pipefail
    # Taken here as well as in `_yb-ab-ref`, because `yb-image.sh` can PULL and because a refusal
    # should arrive before a twenty-minute resolve rather than after it.
    source ./kamu-money-pg/yb/workspace-lock.sh
    workspace_lock "yb-ab" || exit 1
    just _yb-ab-ref "$(./kamu-money-pg/yb/yb-image.sh {{ tag }})"

# The one suite that puts a live extension and a Rust driver in the same process. kamu-money-pg's own
# tests run inside the backend via SPI and cannot drive a client; the driver suites run against
# `text` columns with no extension installed. Neither covers what an application actually does,
# which is read a NATIVE kmoney column through postgres-types / sqlx.
[doc("Dump a schema holding kmoney and restore it into a CLEAN cluster; prove nothing moved.")]
test-yb-restore tag="":
    #!/usr/bin/env bash
    set -euo pipefail
    ./kamu-money-pg/yb/run-yb-restore.sh "$(./kamu-money-pg/yb/yb-image.sh {{ tag }})"

[doc("Extension + driver: a native kmoney column read through both Rust adapters.")]
test-pg-driver major="18":
    ./kamu-money-pg/native-driver-test.sh {{ major }}

# The Rust drivers against a NATIVE `kmoney` column on YugabyteDB -- the one target seam the
# other suites leave split in half.
#
# `test-pg-driver` proves the drivers against native `kmoney` on STOCK PostgreSQL. `test-yb`
# proves the drivers against `text` columns on YugabyteDB. The regress/cluster/concurrent suites
# prove native `kmoney` SQL on YugabyteDB. None of them proves the intersection this project
# actually claims -- a Rust service reading and writing native `kmoney` on YB -- which is where
# YSQL parameter inference, the explicit `($1::text)::kmoney` cast, typmod error propagation and
# driver decoding meet the forked backend.
#
# Both parameters are quoted at the call site because `tag` defaults to empty and `just` args are
# positional.
[doc("The Rust drivers against a NATIVE kmoney column on YugabyteDB (the target integration seam).")]
test-yb-driver tag="" major="18":
    ./kamu-money-pg/yb/run-yb-driver.sh "{{ tag }}" "{{ major }}"

# Every suite reachable WITHOUT a from-source YugabyteDB build. Deliberately not "every engine
# it supports" -- `yb-ab` is not here, and `gate-pg-release` below states that a revision which has
# not run it has not been shown to work on one of the engines this project claims to support.
# Those two comments contradicted each other in this file, 27 lines apart, until 2026-07-25.
#
# `just --list` uses a recipe's LAST comment line as its description, so without this the listing
# rendered the sentence above as `test-pg-all`'s summary -- a note about a fixed contradiction,
# presented as what the recipe does.
[doc("Every suite reachable WITHOUT a from-source YugabyteDB build.")]
test-pg-all: test-yb test-pg test-pg-driver test-yb-driver

# ---------------------------------------------------------------------------------------
# Gates
# ---------------------------------------------------------------------------------------

# `doc-pg` is IN the gate, not beside it. It was a standalone recipe once, and the result was a
# green `gate-pg` sitting next to a red `just doc-pg` -- two rustdoc link errors that would
# have broken the doc-pg.rs build of a crate this gate had just declared releasable. A check
# nobody runs is a check that does not exist.
[doc("The gate for a change that touches no database: format, lint, shell, doc-pg, offline tests.")]
gate-offline: fmt-check lint doc-pg test-hygiene test-regress-selftest artifact-selftest workspace-lock-selftest numa-selftest

# Format, lint, doc-pg, and every suite reachable WITHOUT a from-source YugabyteDB build.
# Expensive already: four extension builds plus a ~1.6GB image pull.
#
# This is NOT the release gate, and the distinction is the whole point. An earlier revision
# of this comment claimed "every container-backed suite" while omitting YugabyteDB entirely;
# adding `test-yb` fixed only half of that, because `test-yb` exercises the TEXT ADAPTER on
# YB, not the native extension. The native path is proven by `yb-ab`, which is kept out of
# this recipe because it compiles the extension from source inside the YB image. Claiming
# "every engine" here while that sat outside was the same overclaim one level down.
[doc("Format, lint, shell, doc-pg, and every suite reachable without a from-source YugabyteDB build.")]
gate-pg: fmt-check lint doc-pg yb-image-selftest artifact-selftest workspace-lock-selftest numa-selftest test-pg-all

# The RELEASE gate: `gate-pg` plus the native YugabyteDB completion gate. YugabyteDB is a
# first-class target, so a revision that has not run these has NOT been shown to work on
# one of the engines this project claims to support. Release status depends on this recipe, not on
# `gate-pg`. CI may cache the heavy YB build or schedule it separately; it may not skip it
# and still call the revision releasable.
#
# THE SIX ARE NOT REDUNDANT, and it is worth saying which question each one answers, because the
# temptation to drop one for wall-clock is real. SIX, not the five this comment claimed until
# 2026-07-26 and not the four it claimed before that: read replicas, then restore, were added to
# the recipe and to the hygiene guard, and only the prose was left behind -- which is how a stage
# becomes droppable without anyone deciding to drop it. The count has now drifted twice, so it is
# worth saying why: the list below is maintained by hand beside a `SUITES` array the code actually
# uses, and only the array is load-bearing. Trust `${SUITES[@]}`; this prose explains it.
#
#   yb-ab               does kmoney behave IDENTICALLY on YugabyteDB and stock PG15?
#                       (byte-exact, but over one ~112-line script)
#   test-yb-regress     do the 63 portable assertions that ARE the contract hold on YB at all?
#                       (the whole contract, but one node, one session)
#   test-yb-cluster     does it hold on EVERY node, and across a tablet split?
#                       (and does a node without the library fail loudly rather than diverge)
#   test-yb-concurrent  does the money still add up when transactions overlap?
#                       (conservation under concurrent double-entry, with a live retry path)
#   test-yb-readreplica does a READ REPLICA agree, and fail loudly without the library?
#                       (replicas are tservers: they run YSQL backends and need the .so themselves,
#                       while CREATE EXTENSION reaches them for free through the catalog)
#
# Each is the exit criterion for one item of the production-readiness plan (E16, E17, E18). A
# revision that is green on the first three and has never run the fourth has not been shown safe
# for money on a real cluster, which is the only claim this gate exists to make.
#
# A BASH RECIPE, not a dependency list, for two reasons. `just` runs prerequisites strictly in
# order and has no `-j`, so a dependency list cannot express "build the artifact once, then run the
# three suites that consume it concurrently" -- and it cannot resolve the image identity ONCE and
# hand the same one to every stage, which is the property that makes the whole run a claim about a
# single image.
#
# `jobs` fans out the five suites in the `SUITES` array (yb-ab stays a barrier before them). They are independent by construction: each brings up its
# own containers, on its own private network, under its own run label. Sequential is still the
# DEFAULT, because this daemon is shared across several organisations' runners -- 7 YugabyteDB
# nodes at once is a decision an operator makes, not one a release gate makes for them.
#
# Parallel output is captured per suite and REPLAYED IN ORDER. This log is the release evidence;
# three suites interleaving would make it unreadable, and unreadable evidence gets skimmed.
[doc("The release gate: gate-pg plus every native YugabyteDB proof. Very expensive.")]
gate-pg-release jobs="1" tag="":
    #!/usr/bin/env bash
    set -euo pipefail

    # VALIDATED, not assumed to be a number. `just` takes recipe arguments POSITIONALLY -- there
    # just-anti-example: the next line shows the BROKEN call on purpose.
    # is no `name=value` call syntax -- so `just gate-pg-release jobs=3` passes the literal string
    # "jobs=3", which reads exactly like it worked. It did not: every `[ "$jobs" -le 1 ]` below
    # died with "integer expected", and a failed `[` inside an `if` or `while` condition is
    # EXEMPT from `set -e`, so the recipe sailed on into the parallel branch with the throttle
    # silently disabled. It passed, by accident, and the log said `jobs=jobs=3`.
    #
    # Measured on the 2026-07-25 gate run. A gate that green-lights a release must not be the
    # thing quietly ignoring its own arguments.
    case "{{ jobs }}" in
        ''|*[!0-9]*)
            echo "gate-pg-release: jobs must be a positive integer, got '{{ jobs }}'" >&2
            echo "gate-pg-release: just takes arguments POSITIONALLY -- use 'just gate-pg-release 3'," >&2
            echo "gate-pg-release: not 'just gate-pg-release jobs=3'." >&2  # just-anti-example
            exit 2 ;;
    esac
    [ "{{ jobs }}" -ge 1 ] || { echo "gate-pg-release: jobs must be >= 1" >&2; exit 2; }

    # ONE RELEASE CHECK AT A TIME IN THIS CHECKOUT. Containers and networks here are isolated by
    # run ID and label; the scratch FILESYSTEM was not. Two concurrent runs share the extracted
    # triplet, the A/B output and its PG15 reference, every regress work directory and the
    # parallel suite logs -- so one run could overwrite what another is mid-way through reading.
    # The reasoning, and why a lock rather than run-scoped paths, is in
    # kamu-money-pg/yb/workspace-lock.sh.
    source ./kamu-money-pg/yb/workspace-lock.sh
    workspace_lock "gate-pg-release" || exit 1

    # Output goes to the caller. Redirect it if you want a file -- `just gate-pg-release 4 > run.log
    # 2>&1`. Piping the body through `tee` in here is what the `set -e` trap below was written
    # about, and not doing it is the simplest way not to have the trap.

    # ONE base identity, for the artifact compile, the PG15 reference AND the text adapter.
    # Resolving per stage is the straddle this exists to prevent.
    #
    # RESOLVED BEFORE `gate-pg`, WHICH IS THE PART THAT CHANGED. It used to be resolved after,
    # and `gate-pg` reaches the YugabyteDB text-adapter test, which named its own image in a
    # Rust constant: `yugabytedb/yugabyte:2025.2.4.1-b4`, a mutable tag one release behind this
    # digest. So the run was one identity for the native extension stages and quietly another for
    # `gate-pg` -- and a retag could change what `gate-pg` tested with nothing here moving.
    YB_REF="$(./kamu-money-pg/yb/yb-image.sh {{ tag }})"
    export KMONEY_YB_IMAGE="$YB_REF"

    just gate-pg

    # AND ONE NODE IMAGE, BUILT ONCE, WHICH IS WHAT EVERY SUITE BELOW ACTUALLY BOOTS.
    #
    # This is the finding that made the previous release evidence not mean what it said. The
    # Justfile, RUNBOOK.md §5 and the adoption contract all name the node image as the deployable
    # artifact -- and every runtime suite here booted the STOCK base image and `docker cp`'d loose
    # files in. So the gate certified a live-install harness while the contract promoted a
    # different image, whose boot, paths, permissions and catalog creation nothing had exercised.
    # The in-image manifest self-check proves files were copied consistently AT BUILD TIME; it
    # cannot prove the image starts a cluster and runs the extension.
    #
    # `YB_REQUIRE_BAKED=1` makes that non-negotiable for the rest of this run: a node that does not
    # already carry kmoney is a failure, not something to install onto. Without it, a node image
    # that failed to deliver the extension would be silently rescued by the harness and the run
    # would still be green -- evidence bound to an artifact that was never exercised.
    NODE_IMAGE="$(./kamu-money-pg/yb/node-image.sh "$YB_REF")"
    export YB_REQUIRE_BAKED=1

    # The loose triplet comes OUT of that image rather than from a second `--target artifact`
    # build. pgrx's generated SQL is not reproducible -- three builds of one revision produced
    # three different SQL hashes -- so a separately built artifact is not guaranteed to be the
    # bytes the image ships, and the whole provenance chain exists to stop exactly that
    # substitution. Extracted, they are the image's own bytes by construction, so the checks
    # below are reading the shipped artifact rather than a lookalike rebuild.
    source ./kamu-money-pg/yb/install.sh
    yb_extract_artifact_from_image "$NODE_IMAGE" kamu-money-pg/yb/out
    yb_resolve_artifacts kamu-money-pg/yb/out

    # NO BENCHMARK SCAFFOLDING IN THE THING THAT SHIPS. `boundary-probe` adds two no-op
    # `#[pg_extern]`s whose only purpose is to be timed (kamu-money-pg/bench/boundary/). They are
    # behind a non-default cargo feature, the YB Dockerfile's EXTRA_FEATURES arg is empty by
    # default, and the probe image is a separate `--target boundary-node` -- three independent
    # reasons they cannot reach production.
    #
    # This checks the BYTES ANYWAY, because all three are properties of build files that someone
    # can edit, and the question "is there a benchmark function in the extension we deploy?"
    # should be answered by looking at the extension we deploy. It reads the artifact extracted
    # from the node image, so it is the shipped SQL and the shipped library, not a rebuild.
    for sym in rs_noop rs_noop_kmoney; do
        if grep -qi "$sym" "$YB_ART_SQL"; then
            echo "gate-pg-release: REFUSING -- the shipped install SQL declares '$sym'." >&2
            echo "gate-pg-release: that is boundary-probe scaffolding and must never be in a" >&2
            echo "gate-pg-release: deployable node image. Rebuild without EXTRA_FEATURES." >&2
            exit 1
        fi
        if nm -D --defined-only "$YB_ART_SO" 2>/dev/null | grep -qi "$sym"; then
            echo "gate-pg-release: REFUSING -- the shipped kmoney.so exports '$sym'." >&2
            exit 1
        fi
    done
    echo "gate-pg-release: the shipped artifact carries no benchmark scaffolding"

    echo "gate-pg-release: base image $YB_REF"
    echo "gate-pg-release: every suite below boots the NODE IMAGE $NODE_IMAGE"

    # yb-ab is the one genuine barrier: it produces the A/B verdict the suites' results are read
    # against. `_yb-ab-ref`, NOT `yb-ab {{ tag }}` -- passing the tag would re-resolve it, and the
    # claim this recipe makes is that every stage ran against one identity.
    just _yb-ab-ref "$YB_REF" "$NODE_IMAGE"

    SUITES=(
        "regress:./kamu-money-pg/yb/run-yb-regress.sh $NODE_IMAGE"
        "cluster:./kamu-money-pg/yb/run-yb-cluster.sh $NODE_IMAGE"
        "concurrent:./kamu-money-pg/yb/run-yb-concurrent.sh $NODE_IMAGE '' 8 25"
        "readreplica:./kamu-money-pg/yb/run-yb-readreplica.sh $NODE_IMAGE '' 1"
        # Restore is in the RELEASE gate, not beside it. It is required from the moment the first
        # production value exists, not from the first version migration -- and the first time
        # anyone runs it must not be during an incident.
        "restore:./kamu-money-pg/yb/run-yb-restore.sh $NODE_IMAGE"
    )

    if [ "{{ jobs }}" -le 1 ]; then
        for entry in "${SUITES[@]}"; do
            eval "${entry#*:}"
        done
    else
        echo "gate-pg-release: running ${#SUITES[@]} YugabyteDB suites concurrently (jobs={{ jobs }})"
        LOGDIR=kamu-money-pg/yb/out/release-suites
        mkdir -p "$LOGDIR"
        pids=(); names=()
        for entry in "${SUITES[@]}"; do
            name="${entry%%:*}"
            while [ "$(jobs -rp | wc -l)" -ge {{ jobs }} ]; do wait -n || true; done
            eval "${entry#*:}" > "$LOGDIR/$name.log" 2>&1 &
            pids+=("$!"); names+=("$name")
        done
        failed=()
        for i in "${!pids[@]}"; do
            wait "${pids[$i]}" || failed+=("${names[$i]}")
            echo "=============================== ${names[$i]} ==============================="
            cat "$LOGDIR/${names[$i]}.log"
        done
        if [ "${#failed[@]}" -ne 0 ]; then
            echo "gate-pg-release: FAILED suites: ${failed[*]}" >&2
            exit 1
        fi
    fi
    # Recorded only HERE, after every stage has actually returned zero. A `stages` line written
    # up-front would name what the recipe intended to run, which is not the same claim.
    #
    echo "gate-pg-release: all stages green on $NODE_IMAGE"
    echo
    echo "gate-pg-release: PASS"


# ---------------------------------------------------------------------------------------
# Release identity
# ---------------------------------------------------------------------------------------


# ---------------------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------------------

# Prove no container outlived its test. Dangling is never harmless.
containers:
    #!/usr/bin/env bash
    set -uo pipefail
    # Filter by LABEL, not by name prefix or ancestor. test-matrix.sh labels everything it
    # creates `kamu-money-pg.run=<revision>-<pid>-<entropy>`, so this sees only containers this
    # workspace made -- and cannot see, or offer to delete, another org's work on the shared
    # daemon.
    left=$(docker ps -aq --filter 'label=kamu-money-pg.revision' 2>/dev/null)
    if [ -z "$left" ]; then
        echo "clean: no container from this workspace is still around"
        exit 0
    fi
    echo "leftover containers from this workspace:"
    docker ps -a --filter 'label=kamu-money-pg.revision'
    echo
    echo "remove them with: docker rm -f \$(docker ps -aq --filter 'label=kamu-money-pg.revision')"
    exit 1

