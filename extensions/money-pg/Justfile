doc-pg-all:
    #!/usr/bin/env bash
    set -euo pipefail
    export RUSTDOCFLAGS="-D warnings"
    for pg in 15 16 17 18; do
        echo "=== rustdoc kamu-money-pg pg${pg} ==="
        cargo doc {{ CORE_PATCH }} -p kamu-money-pg --no-default-features --features "pg${pg}" --no-deps
    done

