{
  "rust": {
    "primary": "1.96.0",
    "msrv": "1.94.0",
    "primary_components": [
      "clippy",
      "rustfmt",
      "rust-src"
    ],
    "msrv_components": [
      "rust-src"
    ],
    "primary_targets": [
      "thumbv7em-none-eabi",
      "wasm32-unknown-unknown"
    ]
  },
  "cargo_tools": [
    {
      "workflow_name": "just",
      "crate": "just",
      "binary": "just",
      "version": "1.57.0",
      "version_args": [
        "--version"
      ]
    },
    {
      "workflow_name": "taplo-cli",
      "crate": "taplo-cli",
      "binary": "taplo",
      "version": "0.10.0",
      "version_args": [
        "--version"
      ]
    },
    {
      "workflow_name": "typos-cli",
      "crate": "typos-cli",
      "binary": "typos",
      "version": "1.48.0",
      "version_args": [
        "--version"
      ]
    },
    {
      "workflow_name": "cargo-llvm-cov",
      "crate": "cargo-llvm-cov",
      "binary": "cargo-llvm-cov",
      "version": "0.8.7",
      "version_args": [
        "llvm-cov",
        "--version"
      ]
    },
    {
      "workflow_name": "cargo-deny",
      "crate": "cargo-deny",
      "binary": "cargo-deny",
      "version": "0.20.2",
      "version_args": [
        "--version"
      ]
    },
    {
      "workflow_name": "cargo-nextest",
      "crate": "cargo-nextest",
      "binary": "cargo-nextest",
      "version": "0.9.140",
      "version_args": [
        "--version"
      ]
    }
  ],
  "node_tools": [
    {
      "package": "markdownlint-cli2",
      "binary": "markdownlint-cli2",
      "version": "0.23.2"
    }
  ],
  "system_tools": [
    {
      "workflow_name": "shellcheck",
      "binary": "shellcheck",
      "version": "0.11.0",
      "version_args": [
        "--version"
      ],
      "install_hint": "Install ShellCheck 0.11.0 with the operating system package manager, then rerun setup."
    }
  ],
  "ci_only_tools": {
    "cargo-pgrx": "0.19.1"
  }
}
